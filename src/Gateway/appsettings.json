{
  "Logging": {
    "LogLevel": {
      "MassTransit": "Debug",
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MessageBroker": {
    "Host": "rabbitmq://rabbitmq",
    "Username": "guest",
    "Password": "guest"
  },

  "ReverseProxy": {
    "Routes": {
      "caseService": {
        "ClusterId": "caseCluster",
        "Match": { "Path": "/cases/{**catch-all}" }
      },
      "consultantService": {
        "ClusterId": "consultantCluster",
        "Match": { "Path": "/consultants/{**catch-all}" }
      },
      "authService": {
        "ClusterId": "authCluster",
        "Match": { "Path": "/auth/{**catch-all}" }
      },  
      "embeddingService": {
        "ClusterId": "embeddingCluster",
        "Match": { "Path": "/embedding/{**catch-all}" }
      }
    },
    "Clusters": {
      "caseCluster": {
        "Destinations": {
          "case1": { "Address": "http://cases:8080/" }
        }
      },
      "consultantCluster": {
        "Destinations": {
          "consultant1": { "Address": "http://consultants:8080/" }
        }
      },
      "authCluster": {
        "Destinations": {
          "auth1": { "Address": "http://auth:8080/" }
        }
      },
      "embeddingCluster": {
        "Destinations": {
          "embedding1": { "Address": "http://embedding:8080/" }
        }
      }

    }
  }
}
